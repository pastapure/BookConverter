# YouTube Transcript Pipeline — Configuration
# Copy this to .env and fill in your credentials.

# KB API endpoints
KB_URL=https://askdomainexpert.com/query
KB_TOKEN_URL=https://askdomainexpert.com/login
KB_UPLOAD_URL=https://askdomainexpert.com/documents/upload

# KB authentication credentials
KB_USERNAME=your_username
KB_PASSWORD=your_password

# Optional: YouTube transcript proxy (for cloud provider IP blocks)
# YT_PROXY=http://user:pass@proxy.example.com:8080

# Optional: YouTube cookies file (Netscape format) for bypassing IP blocks
# YT_COOKIES=/path/to/cookies.txt

# ── Whisper / Diarization ───────────────────────────────────────────
# WHISPER_MODEL=base
# WHISPER_DEVICE=cuda
# ENABLE_DIARIZATION=false
# SPEAKER_ID_THRESHOLD=0.6

# ── TTS podcast generation (edge-tts) ───────────────────────────────
# Voice mapping as JSON: {"SPEAKER_00":"en-US-GuyNeural","SPEAKER_01":"en-US-JennyNeural"}
# TTS_VOICE_MAP_JSON={"SPEAKER_00":"en-US-GuyNeural","SPEAKER_01":"en-US-JennyNeural"}
# TTS_PAUSE_MS=800
# TTS_DEFAULT_VOICE_00=en-US-GuyNeural
# TTS_DEFAULT_VOICE_01=en-US-JennyNeural

# ── ElevenLabs TTS → Coqui XTTS-v2 dataset generation ───────────────
# ELEVENLABS_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ELEVENLABS_VOICE_ID=lxYfHSkYm1EzQzGhdbfc

# ── Coqui TTS (local XTTS-v2 voice cloning) ──────────────────────────
# TTS_BACKEND=coqui
# COQUI_REFERENCE_WAV=path/to/reference_voice.wav

# ── XTTS-v2 Finetuning ──────────────────────────────────────────────
# EVERY variable in this section is REQUIRED — there are no defaults in code.
# Copy this whole block to your .env and adjust paths/values as needed.

# Absolute path to the BookConverter project root
XTTS_PROJECT_ROOT=D:/Projects/BookConverter

# ── Dataset ──────────────────────────────────────────────────────────
XTTS_DATASET_PATH=D:/Projects/BookConverter/data/tts/voice3
XTTS_DATASET_NAME=voice3
XTTS_LANGUAGE=hi
XTTS_EVAL_SPLIT_RATIO=0.1

# ── Model Paths ──────────────────────────────────────────────────────
XTTS_PRETRAINED_MODEL_ROOT=D:/Projects/BookConverter/models/xtts_v2
XTTS_SPEAKER_REFERENCE_ROOT=D:/Projects/BookConverter/models/voice3
XTTS_SPEAKER_REFERENCE_WAV=D:/Projects/BookConverter/models/voice3/reference.wav
XTTS_OUTPUT_PATH=D:/Projects/BookConverter/models/voice3
XTTS_OUTPUT_DIR_NAME=training_output

# ── Training Hyperparameters ─────────────────────────────────────────
XTTS_EPOCHS=50
XTTS_BATCH_SIZE=2
XTTS_EVAL_BATCH_SIZE=1
XTTS_LEARNING_RATE=5e-06
XTTS_GRAD_ACCUM_STEPS=32          # effective batch = BATCH_SIZE × this
XTTS_SAVE_N_CHECKPOINTS=5

# ── Logging ──────────────────────────────────────────────────────────
XTTS_RUN_NAME=hindi_voice3_finetune
XTTS_PROJECT_NAME=xtts_finetuning_project
XTTS_SAVE_STEP=50
XTTS_PLOT_STEP=25

# ── GPU ──────────────────────────────────────────────────────────────
XTTS_GPU=0                         # comma-separated GPU IDs, empty for CPU

# ── Test Sentences ───────────────────────────────────────────────────
# JSON file with sentences spoken at evaluation checkpoints.
XTTS_TEST_SENTENCES_JSON=D:/Projects/BookConverter/data/tts/voice3/test_sentences.json

# ── Inference ───────────────────────────────────────────────────────
# Override the auto-detected best checkpoint.
# XTTS_CHECKPOINT_PATH=D:/Projects/BookConverter/models/voice3/best_model_1017.pth
XTTS_INFERENCE_TEMPERATURE=0.75
XTTS_INFERENCE_REPETITION_PENALTY=5.0

# ── Ideogram 4.0 Image Generation (local, HuggingFace Diffusers) ─────
# HuggingFace token for gated model download (one-time).
# Get yours at https://huggingface.co/settings/tokens
# HF_TOKEN=hf_your_token_here

# Where to store model weights (~9 GB download).
# Default: C:/huggingface_models/ideogram4
# IDEOGRAM_CACHE_DIR=C:/huggingface_models/ideogram4
